# Copy this file to .secrets for local runs. Never commit .secrets.
# GitHub Actions uses repository secrets instead; see docs/setup-secrets.md.
#
# `pnpm ingest`, `pnpm score`, `pnpm notify`, `pnpm eval`, and
# `pnpm validate:data` load .secrets automatically when it exists.
NTFY_TOPIC=
AA_API_KEY=

# Dedicated low-budget inference key for the free-model eval harness.
# It is injected by the eval proxy and is never passed to the agent or test
# container. The models are free, but the inference endpoint still requires it.
OPENCODE_API_KEY=
