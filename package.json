{
  "name": "opencode-model-guide",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @omg/web dev",
    "build": "pnpm --filter @omg/web build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node --env-file-if-exists=.secrets --import tsx packages/ingest/src/run.ts",
    "score": "node --env-file-if-exists=.secrets --import tsx packages/scoring/src/run.ts",
    "notify": "node --env-file-if-exists=.secrets --import tsx packages/notify/src/run.ts",
    "validate:data": "node --env-file-if-exists=.secrets --import tsx scripts/validate-data.ts"
  },
  "devDependencies": {
    "@omg/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
