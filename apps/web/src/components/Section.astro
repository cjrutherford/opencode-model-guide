---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section id={id} class="mt-20 sm:mt-28" aria-labelledby={headingId}>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={headingId} class="mt-2 font-display text-3xl tracking-tight sm:text-4xl">
        {title}
      </h2>
      {
        description && (
          <p class="mt-3 max-w-xl text-base leading-7 text-muted">{description}</p>
        )
      }
    </div>
    <div class="shrink-0">
      <slot name="action" />
    </div>
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
