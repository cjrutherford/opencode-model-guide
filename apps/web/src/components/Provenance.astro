---
import type { ModelRecord } from "@omg/shared";

import {
  formatConflictValue,
  formatDateTime,
  formatSource,
} from "../lib/format";

interface Props {
  model: ModelRecord;
}

const { model } = Astro.props;
---

<div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
  <div>
    <h3 class="font-display text-xl tracking-tight">Sources</h3>
    <ul class="mt-3 divide-y divide-line border-y border-line">
      {
        model.sources.map((source) => (
          <li class="py-3">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <a class="text-sm font-semibold" href={source.url} rel="noreferrer">
                {formatSource(source.id)}
              </a>
              <span class="text-xs text-muted">
                fetched <time datetime={source.fetchedAt}>{formatDateTime(source.fetchedAt)}</time>
              </span>
            </div>
            {source.fields && source.fields.length > 0 && (
              <p class="mt-1 text-xs text-muted">
                Fields: {source.fields.join(", ")}
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-xs text-muted">
      Last seen in a source refresh:{" "}
      <time datetime={model.lastSeen}>{formatDateTime(model.lastSeen)}</time>
    </p>
  </div>

  <div>
    <h3 class="font-display text-xl tracking-tight">Source conflicts</h3>
    {
      model.conflicts.length === 0 ? (
        <p class="mt-3 text-sm text-muted">
          No source conflicts recorded for this model.
        </p>
      ) : (
        <ul class="mt-3 space-y-4">
          {model.conflicts.map((conflict) => (
            <li class="border-t border-line pt-3">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="text-sm font-semibold">{conflict.field}</span>
                <span
                  class:list={[
                    "text-xs font-semibold uppercase tracking-wide",
                    conflict.resolution === "preferred"
                      ? "text-good"
                      : "text-warn",
                  ]}
                >
                  {conflict.resolution}
                </span>
              </div>
              <ul class="mt-2 space-y-1 text-xs text-muted">
                {conflict.values.map((value) => (
                  <li>
                    <span class="font-semibold text-ink">{value.source}</span>
                    {": "}
                    <span class="break-words">{formatConflictValue(value.value)}</span>
                  </li>
                ))}
              </ul>
              {conflict.note && (
                <p class="mt-2 text-xs leading-5 text-muted">{conflict.note}</p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
