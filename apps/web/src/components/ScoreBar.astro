---
import type { UseCaseScore } from "@omg/shared";

import { formatConfidence, formatScore } from "../lib/format";

interface Props {
  label: string;
  score?: UseCaseScore;
}

const { label, score } = Astro.props;
const hasScore =
  score !== undefined &&
  score.score !== null &&
  Number.isFinite(score.score);
const rated = hasScore && score.tier !== "unrated";
const width = hasScore ? Math.min(100, Math.max(0, score.score ?? 0)) : 0;
const confidence =
  score && Number.isFinite(score.confidence)
    ? formatConfidence(score.confidence)
    : "—";
---

<div class="min-w-0">
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <h3 class="font-semibold">{label}</h3>
    <p class="num text-sm">
      {
        hasScore && score?.score !== null && score?.score !== undefined
          ? `${formatScore(score.score)} / 100`
          : "Insufficient data"
      }
    </p>
  </div>
  <div class="score-track mt-2" aria-hidden="true">
    <div
      class:list={["score-fill", { "score-fill--muted": !rated }]}
      style={`width: ${width}%`}
    ></div>
  </div>
  <p class="mt-1.5 text-xs text-muted">
    {
      hasScore && score
        ? rated
          ? `${score.tier} tier · ${confidence} confidence`
          : `Unrated · ${confidence} confidence · coverage or freshness too low`
        : confidence === "—"
          ? "No confidence estimate"
          : `${confidence} confidence · coverage too low`
    }
  </p>
</div>
