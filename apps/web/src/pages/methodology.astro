---
import {
  BENCHMARK_IDS,
  COST_PROFILE_IDS,
  COST_PROFILES,
  FRESHNESS,
  TIER_THRESHOLDS,
  USE_CASE_IDS,
  USE_CASE_WEIGHTS,
} from "@omg/shared";

import Base from "../layouts/Base.astro";
import { loadData } from "../lib/data";
import { BENCHMARK_LABELS, formatDateTime, formatSource, formatTokens } from "../lib/format";
import { latestUpdatedAt } from "../lib/home";
import {
  CONFIDENCE_LABELS,
  EVENT_LABELS,
  FREE_KIND_LABELS,
} from "../lib/labels";
import {
  METHODOLOGY_CHANGELOG,
  METHODOLOGY_VERSION,
} from "../lib/methodology";
import { url } from "../lib/url";

const data = loadData();
const updatedAt = latestUpdatedAt(data.snapshot, data.scores, data.benchmarks);
const sources = [...data.snapshot.sources, ...data.benchmarks.sources];

const freeKindNotes: Record<string, string> = {
  "open-free": "No token charge under the published open terms.",
  "limited-time": "A time-limited offer; the end date or terms may change.",
  "subscription-included": "Usable through a Go or Go Plus plan rather than a free token allowance.",
  trial: "Trial access with published limits or eligibility terms.",
  paid: "List price applies; the model may still be useful, but it is not free.",
};

const tierNotes: Record<string, string> = {
  S: "Strongest available evidence in the use case.",
  A: "Strong, with a smaller evidence gap than S.",
  B: "Capable; check the underlying benchmark coverage.",
  C: "Useful in the use case, with weaker or thinner evidence.",
  D: "Limited evidence or capability for this use case.",
};

const profile = COST_PROFILES["agentic-pr"];
const exampleInput = 5;
const exampleCacheRead = 0.5;
const exampleOutput = 25;
const exampleBillableInput = profile.inputTokens - profile.cachedInputTokens;
const exampleCost =
  (exampleBillableInput * exampleInput +
    profile.cachedInputTokens * exampleCacheRead +
    profile.outputTokens * exampleOutput) /
  1_000_000;

function weightFor(useCase: (typeof USE_CASE_IDS)[number], benchmark: string): number {
  return (
    (USE_CASE_WEIGHTS[useCase] as Record<string, number>)[benchmark] ?? 0
  );
}

function totalWeight(useCase: (typeof USE_CASE_IDS)[number]): number {
  return Object.values(USE_CASE_WEIGHTS[useCase]).reduce(
    (total, weight) => total + weight,
    0,
  );
}

function freshnessLabel(maxDays: number): string {
  return Number.isFinite(maxDays) ? `${maxDays} days` : "Older than 180 days";
}

function percent(value: number): string {
  return `${Math.round(value * 100)}%`;
}

const useCaseLabels = {
  "agentic-coding": "Agentic coding",
  "everyday-edits": "Everyday edits",
  frontend: "Frontend",
  "long-context": "Long context",
} as const;
---

<Base
  title="Methodology — how OpenCode model costs and tiers are calculated"
  description="The formulas, weights, freshness rules, source status, and limitations behind the OpenCode Model Guide's modeled costs and use-case tiers."
  updatedAt={updatedAt}
>
  <div class="mx-auto max-w-[1120px] px-5 py-12 sm:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Methodology · version {METHODOLOGY_VERSION}</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.02] tracking-tight sm:text-5xl">
        How the guide decides.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
        Every cost and tier is a documented calculation over public list prices
        and public benchmark results. There is no single opaque score: costs are
        modeled per task, quality is reported per use case, and missing evidence
        stays missing.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a class="font-semibold underline decoration-line underline-offset-4 hover:decoration-accent" href={url("/changes")}>
          See the change log
        </a>
        <a class="font-semibold underline decoration-line underline-offset-4 hover:decoration-accent" href={url("/health")}>
          Check source health
        </a>
        <a class="font-semibold underline decoration-line underline-offset-4 hover:decoration-accent" href={url("/feed.xml")}>
          RSS
        </a>
      </div>
    </header>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="scope-title" id="scope">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">01 · Scope</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="scope-title">
            What is measured
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl space-y-5 text-sm leading-7 text-muted">
          <p>
            The guide covers models that OpenCode exposes directly: Console
            pay-as-you-go models and models available through the Go and Go Plus
            plans. It does not attempt to rank models available only through
            unrelated providers or local runtimes.
          </p>
          <p>
            “Free” is not one state. It is one of five published labels, and the
            label is never collapsed into a single boolean. A model can be free
            today, free only during a promotion, included in a subscription, or
            available only as a trial.
          </p>
          <div class="overflow-x-auto border border-line">
            <table class="data-table">
              <caption>Free labels shown throughout the guide.</caption>
              <thead>
                <tr>
                  <th scope="col">Label</th>
                  <th scope="col">Meaning</th>
                  <th scope="col">Modeled token cost</th>
                </tr>
              </thead>
              <tbody>
                {Object.entries(FREE_KIND_LABELS).map(([kind, label]) => (
                  <tr>
                    <th scope="row" class="whitespace-nowrap">{label}</th>
                    <td>{freeKindNotes[kind]}</td>
                    <td class="num whitespace-nowrap">
                      {kind === "open-free" || kind === "limited-time" || kind === "trial"
                        ? "$0"
                        : kind === "subscription-included"
                          ? "List cost + plan share"
                          : "List price"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            Availability, terms, and flags are separate facts. A model may be
            marked free by its terms but be deprecated or unavailable at an
            endpoint. Flags such as usage limits, region exclusions, uncertain
            terms, and training/privacy notes are shown on model pages; they can
            add a caveat but do not relabel the free kind.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="cost-title" id="cost">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">02 · Cost model</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="cost-title">
            Modeled list cost
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl space-y-6 text-sm leading-7 text-muted">
          <p>
            Costs are modeled for three fixed task profiles. They are not bills:
            they use published per-token list prices and a fixed token mix, then
            show the result for a consistent comparison. Display rounding happens
            only after the full-precision calculation.
          </p>

          <div class="overflow-x-auto border border-line">
            <table class="data-table">
              <caption>Token profiles used by the cost model.</caption>
              <thead>
                <tr>
                  <th scope="col">Profile</th>
                  <th scope="col">Input tokens</th>
                  <th scope="col">Cached input</th>
                  <th scope="col">Output tokens</th>
                </tr>
              </thead>
              <tbody>
                {COST_PROFILE_IDS.map((id) => {
                  const item = COST_PROFILES[id];
                  return (
                    <tr>
                      <th scope="row">{item.label}</th>
                      <td class="num">{formatTokens(item.inputTokens)}</td>
                      <td class="num">{formatTokens(item.cachedInputTokens)}</td>
                      <td class="num">{formatTokens(item.outputTokens)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <div>
            <h3 class="font-display text-2xl tracking-tight text-ink">The formula</h3>
            <pre class="mt-3 overflow-x-auto border border-line bg-raised p-4 font-mono text-xs leading-6 text-ink"><code>{`billableInput = inputTokens - cachedInputTokens

cacheReadPrice = cacheRead ?? input

cost =
  billableInput × inputPrice / 1,000,000
  + cachedInputTokens × cacheReadPrice / 1,000,000
  + outputTokens × outputPrice / 1,000,000`}</code></pre>
            <p class="mt-3">
              If <code>inputTokens</code> is over 200,000 and a{" "}
              <code>contextOver200k</code> price book exists, that book applies to
              the whole request. Otherwise, the highest tier whose{" "}
              <code>minInputTokens</code> is at or below the request applies to the
              whole request. This matches the common vendor convention and avoids
              mixing price books inside one request.
            </p>
          </div>

          <div class="border-l-2 border-accent pl-4">
            <p class="font-semibold text-ink">Worked example</p>
            <p class="mt-1">
              Agentic PR profile at a $5 input / $0.50 cache-read / $25 output
              list price:
            </p>
            <p class="mt-2 font-mono text-xs leading-6 text-ink">
              ({exampleBillableInput.toLocaleString()} × ${exampleInput} +{" "}
              {profile.cachedInputTokens.toLocaleString()} × ${exampleCacheRead} +{" "}
              {profile.outputTokens.toLocaleString()} × ${exampleOutput}) / 1,000,000
              = <strong>${exampleCost.toFixed(3)}</strong>
            </p>
            <p class="mt-2 text-xs">
              The UI rounds this to {`$${exampleCost.toFixed(2)}`} for display. The
              committed data keeps full precision.
            </p>
          </div>

          <div>
            <h3 class="font-display text-2xl tracking-tight text-ink">
              Free labels, unknown prices, and Go
            </h3>
            <ul class="mt-3 list-disc space-y-2 pl-5">
              <li>
                <strong class="text-ink">
                  Free, Free · limited time, and Free · trial terms
                </strong>{" "}
                are modeled at $0 for the token profiles. The label is applied
                independently of live availability so the cost model stays
                comparable; availability is shown separately.
              </li>
              <li>
                <strong class="text-ink">Subscription-included</strong> keeps the
                list cost and also shows a full-utilization Go/Go Plus estimate:{" "}
                <code>goEffective = listCost × planUsd / includedUsageUsd</code>.
                This is the per-task share of the plan if the included usage is
                fully consumed, not a promise about a monthly bill.
              </li>
              <li>
                <strong class="text-ink">Unknown pricing</strong> is{" "}
                <code>null</code>, displayed as “price not published.” It is never
                treated as $0.
              </li>
              <li>
                Prices are public list prices from the snapshot. Taxes, regional
                differences, negotiated rates, cache writes, and plan overages are
                outside the model.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="quality-title" id="quality">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">03 · Quality model</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="quality-title">
            Evidence per use case
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl space-y-6 text-sm leading-7 text-muted">
          <p>
            Quality is a weighted percentile of public benchmark results. Each
            use case has its own weights, and each benchmark is ranked separately
            against the models that have a result for it. There is no global
            “best model” number.
          </p>
          <p>
            Console and Go listings of the same underlying model share the same
            benchmark evidence. Free terms, availability, and modeled costs are
            still computed separately for each listing, because the commercial
            offer can differ even when the model does not.
          </p>

          <div class="overflow-x-auto border border-line">
            <table class="data-table">
              <caption>Benchmark weights by use case. Blank cells are not part of that use case.</caption>
              <thead>
                <tr>
                  <th scope="col">Benchmark</th>
                  {USE_CASE_IDS.map((useCase) => (
                    <th scope="col" class="text-center">
                      {useCaseLabels[useCase]}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {BENCHMARK_IDS.map((benchmark) => (
                  <tr>
                    <th scope="row">{BENCHMARK_LABELS[benchmark]}</th>
                    {USE_CASE_IDS.map((useCase) => (
                      <td class="num text-center">
                        {weightFor(useCase, benchmark) > 0
                          ? percent(weightFor(useCase, benchmark))
                          : "—"}
                      </td>
                    ))}
                  </tr>
                ))}
                <tr>
                  <th scope="row">Total</th>
                  {USE_CASE_IDS.map((useCase) => (
                    <td class="num text-center">{percent(totalWeight(useCase))}</td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>

          <div>
            <h3 class="font-display text-2xl tracking-tight text-ink">
              Percentiles and the weighted score
            </h3>
            <p class="mt-2">
              Within a benchmark, a model’s percentile is based on its position
              among the models that have a result. Ties sit at their average
              position; a benchmark with a single observation returns 50 because
              it has no spread to rank against.
            </p>
            <pre class="mt-3 overflow-x-auto border border-line bg-raised p-4 font-mono text-xs leading-6 text-ink"><code>{`percentile = clamp(
  ((lower + (equal - 1) / 2) / (n - 1)) × 100,
  0, 100
)

rawScore = Σ(weight × percentile) / Σ(available weight)

confidence = Σ(weight × freshness(benchmark date))`}</code></pre>
            <p class="mt-3">
              A missing benchmark is not filled with a zero. It reduces the
              available weight and therefore lowers confidence. Freshness is
              applied to each benchmark separately, so a stale result lowers only
              its own contribution and does not erase fresher evidence. The score
              is still shown alongside that confidence; the tier is withheld when
              coverage or confidence is too thin.
            </p>
          </div>

          <div class="overflow-x-auto border border-line">
            <table class="data-table">
              <caption>Rated tiers, from the weighted percentile.</caption>
              <thead>
                <tr>
                  <th scope="col">Tier</th>
                  <th scope="col">Minimum score</th>
                  <th scope="col">Reading</th>
                </tr>
              </thead>
              <tbody>
                {TIER_THRESHOLDS.map((threshold) => (
                  <tr>
                    <th scope="row" class="num">{threshold.tier}</th>
                    <td class="num">{threshold.min}</td>
                    <td>{tierNotes[threshold.tier]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="overflow-x-auto border border-line">
            <table class="data-table">
              <caption>Freshness factors applied to each benchmark's own date.</caption>
              <thead>
                <tr>
                  <th scope="col">Benchmark age</th>
                  <th scope="col">Factor</th>
                </tr>
              </thead>
              <tbody>
                {FRESHNESS.map((bucket) => (
                  <tr>
                    <th scope="row">{freshnessLabel(bucket.maxDays)}</th>
                    <td class="num">{bucket.factor.toFixed(1)}×</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div>
            <h3 class="font-display text-2xl tracking-tight text-ink">
              Confidence and “Insufficient data”
            </h3>
            <p class="mt-2">
              A tier is withheld when less than half of the use-case weight is
              available or when confidence is below 30%. Confidence is the sum of
              each available benchmark's weight times its own freshness factor, so
              fresh evidence is not vetoed by an unrelated stale result.
              Long-context scoring also requires a published context window of at
              least 200,000 tokens. Missing scores are shown as “Insufficient
              data,” never as a zero.
            </p>
            <div class="mt-3 grid gap-3 sm:grid-cols-3">
              <div class="border border-line p-3">
                <p class="font-semibold text-ink">{CONFIDENCE_LABELS.high} confidence</p>
                <p class="num text-xs">0.75–1.00</p>
              </div>
              <div class="border border-line p-3">
                <p class="font-semibold text-ink">{CONFIDENCE_LABELS.medium} confidence</p>
                <p class="num text-xs">0.45–0.749</p>
              </div>
              <div class="border border-line p-3">
                <p class="font-semibold text-ink">{CONFIDENCE_LABELS.low} confidence</p>
                <p class="num text-xs">0.00–0.449</p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="font-display text-2xl tracking-tight text-ink">
              Name resolution
            </h3>
            <p class="mt-2">
              Benchmark names are matched to model keys without fuzzy guesses
              being hidden. Exact key, ID, and normalized-name matches win first.
              Curated aliases win next. Remaining names are compared by token
              overlap (Dice coefficient): at least 0.85, at least 0.90 when the
              token counts differ, and a 0.05 gap over the next candidate. Anything
              else is listed as unmatched on the health page with its source and
              date.
            </p>
            <p class="mt-2">
              When several models share a name or ID, the resolver prefers models
              with a free label and then the Console provider. The full unmatched
              and conflict lists are visible on{" "}
              <a href={url("/health")}>Data health</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="evals-title" id="evals">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">04 · Experimental evals</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="evals-title">
            Local eval, kept separate
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl space-y-5 text-sm leading-7 text-muted">
          <p>
            The guide also publishes a first-party local eval of free models. It
            runs a fixed 12-task corpus — 6 TypeScript or JavaScript, 3 Python,
            and 3 Go — through the real OpenCode agent loop or a direct-patch
            adapter, then checks the result with hidden tests. Hidden tests and
            reference solutions stay host-side. Results are committed in{" "}
            <code>data/evals.json</code>.
          </p>
          <p>
            This is explicitly <strong class="text-ink">not part of the composite</strong>.
            Eval results do not change use-case weights, benchmark percentiles,
            tiers, confidence, home-page top picks, or free-lane eligibility. No
            single overall eval score is produced. The public surface reports
            per-task outcomes, pass rate over completed hidden tests, coverage,
            tokens per solved task, median duration, and run provenance.
          </p>
          <div class="border-l-2 border-warn pl-4">
            <p class="font-semibold text-ink">Not a public benchmark</p>
            <p class="mt-1">
              The corpus is small, fixed, and first-party. The first official run
              uses one repeat and only live Console free models. A pass rate from
              this run is directional evidence about these tasks, not a population
              sample, a leaderboard, or a number comparable to the benchmark
              composite. “Not run” is not a failure; missing token usage stays
              missing rather than becoming zero.
            </p>
          </div>
          <p>
            The agent runs in a disposable container with a size-capped workspace
            and allowlisted inference egress. The inference key lives only in the
            proxy. Direct-patch results are reported separately; the two modes are
            not interchangeable. When a model’s current access differs from the
            run, the model page says so.
          </p>
          <p>
            <a class="font-semibold underline decoration-line underline-offset-4 hover:decoration-accent" href={url("/evals")}>
              See the experimental eval results →
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="sources-title" id="sources">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">05 · Sources</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="sources-title">
            What we read
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl space-y-5 text-sm leading-7 text-muted">
          <p>
            Official OpenCode documentation is authoritative for free terms,
            plan inclusion, privacy, and limits. The models.dev catalog supplies
            metadata and list prices. Live endpoints establish current
            availability. Public benchmark publishers supply the quality data.
          </p>
          <p>
            The pipeline runs daily at 13:00 UTC and publishes committed
            snapshots. If a required source fails, the previous snapshot is not
            silently replaced with invented values; the failure is recorded in
            the event log and source health.
          </p>
          <div class="overflow-x-auto border border-line">
            <table class="data-table">
              <caption>Source status at this build.</caption>
              <thead>
                <tr>
                  <th scope="col">Source</th>
                  <th scope="col">Kind</th>
                  <th scope="col">Status</th>
                  <th scope="col">Last fetch (UTC)</th>
                  <th scope="col">Items</th>
                </tr>
              </thead>
              <tbody>
                {sources.map((source) => (
                  <tr>
                    <th scope="row">
                      <a href={source.url} target="_blank" rel="noreferrer">
                        {formatSource(source.id)}
                      </a>
                    </th>
                    <td class="whitespace-nowrap">
                      {data.snapshot.sources.some((item) => item.id === source.id)
                        ? "Catalog"
                        : "Benchmarks"}
                    </td>
                    <td
                      class:list={[
                        "whitespace-nowrap font-semibold",
                        source.status === "ok"
                          ? "text-good"
                          : source.status === "failed"
                            ? "text-warn"
                            : "text-muted",
                      ]}
                    >
                      {source.status}
                    </td>
                    <td class="whitespace-nowrap">{formatDateTime(source.fetchedAt)}</td>
                    <td class="num">{source.itemCount ?? "—"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs">
            The Artificial Analysis Coding Index is one input to the agentic and
            everyday composites; its agentic and intelligence indices remain
            supplemental. It is attributed here and on model pages and is not a
            substitute for the benchmark-specific sources. When the optional key
            is absent, those rows are missing and the affected scores lose
            confidence rather than being filled in. No private evaluations or
            local telemetry are collected.
          </p>
          <dl class="grid gap-3 border-t border-line pt-4 text-xs sm:grid-cols-3">
            <div>
              <dt class="eyebrow">Snapshot</dt>
              <dd class="mt-1">{formatDateTime(data.snapshot.generatedAt)}</dd>
            </div>
            <div>
              <dt class="eyebrow">Benchmarks</dt>
              <dd class="mt-1">{formatDateTime(data.benchmarks.generatedAt)}</dd>
            </div>
            <div>
              <dt class="eyebrow">Scores</dt>
              <dd class="mt-1">{formatDateTime(data.scores.generatedAt)}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="limits-title" id="limitations">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">06 · Limits</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="limits-title">
            What this cannot tell you
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl space-y-4 text-sm leading-7 text-muted">
          <ul class="list-disc space-y-2 pl-5">
            <li>
              A modeled list cost is not your invoice. Actual usage, prompt
              caching, cache writes, batch discounts, taxes, and plan overages
              change the bill.
            </li>
            <li>
              Public benchmarks are noisy and often measure a different harness
              or prompt format than your work. A high percentile is evidence, not
              a guarantee.
            </li>
            <li>
              Free terms can change without a new benchmark or a price change.
              The guide records what was published at the last run; it cannot
              guarantee future terms or regional eligibility.
            </li>
            <li>
              Availability is a point-in-time endpoint check. A model may be
              listed in documentation but absent, deprecated, or unavailable in
              your region.
            </li>
            <li>
              Missing benchmark data is left unrated. The guide does not perform
              its own evaluations or infer a score from a model family.
            </li>
            <li>
              We do not measure real-run token efficiency, subjective preference,
              gateway-specific behavior, regional latency, or reliability under
              your workload. Those require measurements this project does not
              collect in v1.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-8" aria-labelledby="version-title" id="version">
      <div class="grid gap-8 lg:grid-cols-[14rem_1fr]">
        <div>
          <p class="eyebrow">07 · Version</p>
          <h2 class="mt-2 font-display text-3xl tracking-tight" id="version-title">
            Changes to the method
          </h2>
        </div>
        <div class="min-w-0 max-w-3xl text-sm leading-7 text-muted">
          <p>
            Current version: <strong class="text-ink">{METHODOLOGY_VERSION}</strong>.
            A formula, weight, threshold, or label change gets a new version and
            a note here. Data refreshes alone do not.
          </p>
          <ol class="mt-5 space-y-4 border-l border-line pl-5">
            {METHODOLOGY_CHANGELOG.map((entry) => (
              <li>
                <p class="font-semibold text-ink">
                  Version {entry.version} · {entry.date}
                </p>
                <p class="mt-1">{entry.note}</p>
              </li>
            ))}
          </ol>
          <p class="mt-5 text-xs">
            Event labels in the change log: {Object.values(EVENT_LABELS).join(", ")}.
          </p>
        </div>
      </div>
    </section>
  </div>
</Base>
