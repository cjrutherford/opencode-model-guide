---
import Base from "../layouts/Base.astro";
import CompareTable from "../components/CompareTable";
import { loadData } from "../lib/data";
import { latestUpdatedAt } from "../lib/home";
import { buildCompareRows } from "../lib/models";

const data = loadData();
const rows = buildCompareRows(data);
const updatedAt = latestUpdatedAt(data.snapshot, data.scores, data.benchmarks);
---

<Base
  title="Compare OpenCode models side by side"
  description="Compare up to four OpenCode-native models by free terms, context, list price, modeled task cost, quality tier, and confidence."
  updatedAt={updatedAt}
>
  <div class="mx-auto max-w-[1120px] px-5 py-12 sm:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Comparison</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.02] tracking-tight sm:text-5xl">
        Put finalists side by side.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
        Pick up to four models. The best comparable value in each row is marked
        in green; unknown prices and unrated use cases stay explicit.
      </p>
    </header>

    <div class="mt-8">
      <CompareTable client:load rows={rows} />
    </div>

    <p class="mt-6 max-w-3xl text-xs leading-5 text-muted">
      The selection is stored in the URL as <code>?models=slug,slug</code>, so a
      reload or shared link restores it. Prices are per million tokens. Modeled
      task costs use the profile token counts and are not invoices.
    </p>
  </div>
</Base>
