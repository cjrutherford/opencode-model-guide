---
import type { FreeKind } from "@omg/shared";

import Base from "../../layouts/Base.astro";
import FreeBadge from "../../components/FreeBadge.astro";
import ModelTable from "../../components/ModelTable";
import Stat from "../../components/Stat.astro";
import { loadData } from "../../lib/data";
import { isFreeNow, buildModelRows } from "../../lib/models";
import { latestUpdatedAt } from "../../lib/home";

const data = loadData();
const rows = buildModelRows(data);
const freeNow = data.snapshot.models.filter(isFreeNow);
const goIncluded = data.snapshot.models.filter(
  (model) =>
    model.availability === "live" &&
    model.free.kind === "subscription-included",
);
const updatedAt = latestUpdatedAt(data.snapshot, data.scores, data.benchmarks);
const legend: FreeKind[] = [
  "open-free",
  "limited-time",
  "trial",
  "subscription-included",
  "paid",
];
---

<Base
  title="OpenCode model comparison: prices, context, and free tiers"
  description="Browse every OpenCode-native model, filter by free terms, context, price, and quality tier, and see the evidence behind each score."
  updatedAt={updatedAt}
>
  <div class="mx-auto max-w-[1120px] px-5 py-12 sm:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Model directory</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.02] tracking-tight sm:text-5xl">
        Every model, one honest comparison.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
        Browse OpenCode-native models from Console and Go. Costs are modeled
        from list prices and profile token counts; every quality tier keeps its
        benchmark coverage and confidence visible.
      </p>
    </header>

    <div class="mt-10 grid grid-cols-2 gap-6 border-y border-line py-6 sm:grid-cols-3">
      <Stat value={rows.length} label="Models tracked" />
      <Stat value={freeNow.length} label="Free right now" tone="accent" hint="Live, no subscription" />
      <Stat value={goIncluded.length} label="Go included" hint="Live subscription-included" />
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <span class="eyebrow mr-1">Free terms</span>
      {
        legend.map((kind) => (
          <FreeBadge
            kind={kind}
            uncertain={false}
          />
        ))
      }
      <span class="text-xs text-muted">
        Dashed badges mean the terms are uncertain.
      </span>
    </div>

    <div class="mt-8">
      <ModelTable client:load rows={rows} />
    </div>

    <p class="mt-6 max-w-3xl text-xs leading-5 text-muted">
      “Free right now” means live, no-subscription free access. Subscription-included
      Go models are tracked separately and are not counted as free-now. The
      agentic task cost uses the modeled PR profile. Best tier is the highest
      rated use case for that model; open a model for all four use cases.
    </p>
  </div>
</Base>
