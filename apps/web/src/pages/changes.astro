---
import type { ChangeEvent, EventType } from "@omg/shared";

import Base from "../layouts/Base.astro";
import { loadData } from "../lib/data";
import {
  EVENT_FILTERS,
  EVENT_GROUPS,
  eventMatchesFilter,
} from "../lib/labels";
import { formatDate, formatEventType, formatUsd } from "../lib/format";
import { latestUpdatedAt } from "../lib/home";
import { modelHref, slugify } from "../lib/models";
import { url } from "../lib/url";

const data = loadData();
const events = data.events;
const updatedAt = latestUpdatedAt(data.snapshot, data.scores, data.benchmarks);
const modelByKey = new Map(
  data.snapshot.models.map((model) => [model.key, model]),
);

const eventTone: Record<EventType, string> = {
  model_added: "text-accent",
  free_started: "text-accent",
  free_ended: "text-accent",
  price_changed: "text-info",
  deprecated: "text-warn",
  source_failed: "text-warn",
};

function eventGroups(type: EventType): string {
  return EVENT_GROUPS[type].join(" ");
}

function eventHref(event: ChangeEvent): string {
  const model = modelByKey.get(event.modelKey);
  return model
    ? modelHref(model)
    : url(`/models/${slugify(event.modelKey)}/`);
}

function asRecord(value: unknown): Record<string, unknown> | undefined {
  return value && typeof value === "object" && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : undefined;
}

interface PriceDelta {
  label: string;
  before: number;
  after: number;
}

function priceDeltas(event: ChangeEvent): PriceDelta[] {
  if (event.type !== "price_changed") return [];
  const before = asRecord(event.data.before);
  const after = asRecord(event.data.after);
  if (!before || !after) return [];

  const labels: Record<string, string> = {
    input: "Input",
    output: "Output",
    cacheRead: "Cache read",
    cacheWrite: "Cache write",
  };

  return Object.entries(labels).flatMap(([key, label]) => {
    const previous = before[key];
    const next = after[key];
    if (
      typeof previous !== "number" ||
      typeof next !== "number" ||
      previous === next
    ) {
      return [];
    }
    return [{ label, before: previous, after: next }];
  });
}

function eventHrefLabel(event: ChangeEvent): string {
  const model = modelByKey.get(event.modelKey);
  return model?.name ?? event.modelKey;
}

const days = events.reduce<
  Array<{ date: string; events: ChangeEvent[] }>
>((groups, event) => {
  const date = event.at.slice(0, 10);
  const current = groups.at(-1);
  if (current?.date === date) {
    current.events.push(event);
  } else {
    groups.push({ date, events: [event] });
  }
  return groups;
}, []);

const visibleCount = events.filter((event) =>
  eventMatchesFilter(event.type, "all"),
).length;
const filterLinks = EVENT_FILTERS.map((filter) => ({
  ...filter,
  href: url(filter.value === "all" ? "/changes" : `/changes?type=${filter.value}`),
}));
---

<Base
  title="OpenCode model changes — free offers, prices, and deprecations"
  description="The append-only change log for OpenCode-native models: free offers starting or ending, price changes, additions, deprecations, and source issues."
  updatedAt={updatedAt}
>
  <div class="mx-auto max-w-[1120px] px-5 py-12 sm:px-8">
    <header class="max-w-3xl">
      <p class="eyebrow">Audit trail</p>
      <h1 class="mt-3 font-display text-4xl leading-[1.02] tracking-tight sm:text-5xl">
        What changed, and when.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted">
        One daily run writes deterministic events. Nothing is edited after the
        fact: free offers, list prices, availability, and source failures stay in
        the log so you can see the evidence behind the current snapshot.
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <a
          class="font-semibold underline decoration-line underline-offset-4 hover:decoration-accent"
          href={url("/feed.xml")}
        >
          Subscribe via RSS
        </a>
        <span class="text-muted">Newest first · UTC</span>
      </p>
    </header>

    <div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-line py-4">
      <span class="eyebrow mr-1">Filter</span>
      {
        filterLinks.map((filter) => (
          <a
            class="filter-chip"
            data-filter={filter.value}
            href={filter.href}
            aria-current={filter.value === "all" ? "page" : undefined}
          >
            {filter.label}
          </a>
        ))
      }
      <span class="ml-auto text-xs text-muted" aria-live="polite" data-event-count>
        {visibleCount} {visibleCount === 1 ? "event" : "events"}
      </span>
    </div>

    <noscript>
      <p class="mt-4 border border-line bg-raised p-4 text-sm text-muted">
        Type filters use a small amount of JavaScript. Without it, every event
        is shown below.
      </p>
    </noscript>

    {
      events.length > 0 ? (
        <div class="mt-10 space-y-12" data-event-list>
          {days.map((day) => (
            <section
              aria-labelledby={`day-${day.date}`}
              data-event-day
            >
              <h2
                class="sticky top-[4.25rem] z-10 border-b border-line bg-paper/95 py-2 font-display text-2xl tracking-tight backdrop-blur sm:top-[4.5rem]"
                id={`day-${day.date}`}
              >
                {formatDate(day.date)}
              </h2>
              <ol class="divide-y divide-line">
                {day.events.map((event) => (
                  <li
                    class="grid gap-3 py-5 sm:grid-cols-[7.5rem_1fr] sm:gap-6"
                    data-event-item
                    data-event-type={event.type}
                    data-event-groups={eventGroups(event.type)}
                  >
                    <time class="num text-xs text-muted" datetime={event.at}>
                      {event.at.slice(11, 16)} UTC
                    </time>
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <span
                          class={`text-[0.75rem] font-bold uppercase tracking-[0.16em] ${eventTone[event.type]}`}
                        >
                          {formatEventType(event.type)}
                        </span>
                        <a
                          class="text-sm font-semibold no-underline hover:text-accent"
                          href={eventHref(event)}
                        >
                          {eventHrefLabel(event)}
                        </a>
                      </div>
                      <p class="mt-1 max-w-2xl text-sm leading-6 text-muted">
                        {event.summary}
                      </p>
                      {
                        priceDeltas(event).length > 0 && (
                          <ul class="mt-2 flex flex-wrap gap-2" aria-label="Price change values">
                            {priceDeltas(event).map((delta) => (
                              <li class="num border border-line bg-raised px-2 py-1 text-xs">
                                <span class="text-muted">{delta.label}</span>{" "}
                                {formatUsd(delta.before)} → {formatUsd(delta.after)}
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <div class="mt-10 border-y border-line py-10" data-empty-all>
          <p class="font-display text-2xl tracking-tight">
            No changes recorded yet.
          </p>
          <p class="mt-2 max-w-xl text-sm leading-6 text-muted">
            The first baseline is in place; new changes will appear here.
          </p>
        </div>
      )
    }

    <div
      class="mt-10 border-y border-line py-10"
      data-filter-empty
      hidden
    >
      <p class="font-display text-2xl tracking-tight">
        No changes match this filter.
      </p>
      <p class="mt-2 text-sm text-muted">
        <a href={url("/changes")}>Show all changes</a>.
      </p>
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-5 text-muted">
      Events are deduplicated by type, model, and UTC date. The feed contains the
      newest 100 events and is generated from the same append-only log.
    </p>
  </div>
</Base>

<script is:inline>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const selected = params.get("type") || "all";
    const items = [...document.querySelectorAll("[data-event-item]")];
    const days = [...document.querySelectorAll("[data-event-day]")];
    const chips = [...document.querySelectorAll("[data-filter]")];
    const count = document.querySelector("[data-event-count]");
    const filterEmpty = document.querySelector("[data-filter-empty]");
    const emptyAll = document.querySelector("[data-empty-all]");

    const visible = items.filter((item) => {
      const type = item.getAttribute("data-event-type") || "";
      const groups = (item.getAttribute("data-event-groups") || "").split(" ");
      const show =
        selected === "all" || type === selected || groups.includes(selected);
      item.hidden = !show;
      return show;
    });

    for (const day of days) {
      day.hidden = ![...day.querySelectorAll("[data-event-item]")].some(
        (item) => !item.hidden,
      );
    }

    const exact = items.find(
      (item) => item.getAttribute("data-event-type") === selected,
    );
    const active = exact
      ? (exact.getAttribute("data-event-groups") || "").split(" ")[0] || selected
      : selected;

    for (const chip of chips) {
      if (chip.getAttribute("data-filter") === active) {
        chip.setAttribute("aria-current", "page");
      } else {
        chip.removeAttribute("aria-current");
      }
    }

    if (count) {
      count.textContent = `${visible.length} ${
        visible.length === 1 ? "event" : "events"
      }`;
    }
    if (filterEmpty) {
      filterEmpty.hidden = visible.length !== 0 || items.length === 0;
    }
    if (emptyAll) {
      emptyAll.hidden = items.length > 0;
    }
  })();
</script>
